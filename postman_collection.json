{
  "info": {
    "name": "Fuel Stop Planner API",
    "description": "Cheapest fuel stops between two places in the USA (500-mile range, 10 mpg).\n\nSet `base_url` (default http://127.0.0.1:8000) and run the folders in order: \"Same trip, typed differently\" relies on the request before it. The API allows 20 requests a minute per client, so wait a minute between full runs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Plans",
      "item": [
        {
          "name": "Atlanta, GA to Phoenix, AZ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Atlanta, GA\",\n  \"finish\": \"Phoenix, AZ\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/route/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "route",
                ""
              ]
            },
            "description": "A long trip. \"City, ST\" inputs are resolved locally, so this makes one routing call."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const trip = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('fuel covers the whole route at 10 mpg', () => {",
                  "    pm.expect(trip.total_gallons).to.be.closeTo(trip.distance_miles / 10, 0.05);",
                  "});",
                  "pm.test('total cost = fuel to reach the first station + every stop', () => {",
                  "    const sum = trip.fuel_stops.reduce((acc, s) => acc + s.cost, trip.initial_cost);",
                  "    pm.expect(trip.total_cost).to.be.closeTo(sum, 0.05);",
                  "});",
                  "pm.test('fuel_stop_count matches the listed stops', () => {",
                  "    pm.expect(trip.fuel_stop_count).to.eql(trip.fuel_stops.length);",
                  "});",
                  "pm.test('no fill-up is bigger than a 50-gallon (500-mile) tank', () => {",
                  "    trip.fuel_stops.forEach(s => pm.expect(s.gallons).to.be.at.most(50.001));",
                  "});",
                  "pm.test('stops are in route order and no more than 500 miles apart', () => {",
                  "    const miles = trip.fuel_stops.map(s => s.mile).concat([trip.distance_miles]);",
                  "    miles.slice(1).forEach((m, i) => pm.expect(m - miles[i]).to.be.within(0, 500.1));",
                  "});",
                  "pm.test('every station says how it was located', () => {",
                  "    trip.fuel_stops.forEach(s => pm.expect(['exit', 'town']).to.include(s.station.location_source));",
                  "});",
                  "pm.test('map is GeoJSON with the route, both ends and one point per stop', () => {",
                  "    const roles = trip.map.features.map(f => f.properties.role);",
                  "    pm.expect(trip.map.type).to.eql('FeatureCollection');",
                  "    pm.expect(roles).to.include.members(['route', 'start', 'finish']);",
                  "    pm.expect(roles.filter(r => r === 'fuel_stop').length).to.eql(trip.fuel_stops.length);",
                  "    pm.expect(trip.map_url).to.include('/api/route/map/?');",
                  "});",
                  "",
                  "pm.test('a long trip needs several stops', () => pm.expect(trip.fuel_stop_count).to.be.at.least(3));"
                ]
              }
            }
          ]
        },
